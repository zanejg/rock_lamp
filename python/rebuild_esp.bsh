#!/bin/bash


source /home/zane/programming/virtualenv/py3scratch/bin/activate

# check that the user has given us the right number of arguments
if [ "$#" -ne 1 ] && [ "$#" -ne 2 ]; then
    echo "Usage: $0 <espdevice> <cmd>"
    echo "cmd can be 'trash-old' to erase the flash and rewrite the MicroPython firmware"
    exit 1
fi


espdevice=$1
cmd=$2

# espdevice=/dev/ttyUSB0

if [ "$cmd" == "trash-old" ];then
    # trash the present contents of the ESP32
    esptool.py --port $espdevice erase_flash

    # rewite the MicroPython
    # old version esp32-ota-20220618-v1.19.1.bin
    esptool.py --chip esp32 --port $espdevice \
        write_flash -z 0x1000 ~/Downloads/esp32-20230426-v1.20.0.bin
fi


# the system boot file
echo "Writing boot.py"
ampy -p $espdevice put uweb_boot.py boot.py
echo "written boot.py"

# settings
echo "Writing secret_settings.py"
ampy -p $espdevice put secret_settings.py
echo "written secret_settings.py"


# LED drivers
echo "Writing LED_control"
ampy -p $espdevice put LED_control.py
echo "Written LED_control.py"


# the main file to run
echo "Writing main.py"
ampy -p $espdevice put main.py
echo "Written main.py"

echo "Finished"

